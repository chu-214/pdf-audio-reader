    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.4",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
